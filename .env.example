# ==============================================================================
# EFM (Edit Folder Manager) Environment Configuration
# ==============================================================================
# Copy this file to '.env' and customize it for your local environment:
#     cp .env.example .env
#
# NOTE: Never commit your actual '.env' file containing personal paths or secrets.
# ==============================================================================

# [Required] Root directory where your client and personal editing projects are stored.
# Windows Example: EFM_BASE_DIR=C:\Users\username\Videos\Projects
# macOS / Linux Example: EFM_BASE_DIR=/Users/username/Movies/Projects
EFM_BASE_DIR=

# [Optional] Custom path to the configuration JSON file.
# Defaults to %APPDATA%\EFM_Program\efm_config.json on Windows, or ~/.efm/efm_config.json on Linux/macOS
EFM_CONFIG_PATH=

# [Optional] Default UI appearance theme: "dark", "light", or "system"
EFM_APPEARANCE_MODE=dark

# [Optional] Automatically organize raw and stock media into category subfolders upon opening
# Options: "true" or "false"
EFM_AUTO_SORT=true
